@model singleProject.ViewModels.EditProductViewModel

@{
    ViewData["Title"] = "แก้ไขสินค้า";
    Layout = "_SellerLayout";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8 col-md-10">

        <!-- Header Card -->
        <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #1a3a6e, #29579D); border-radius: 16px;">
            <div class="card-body text-white text-center py-4">
                <div class="fs-1 mb-2">✏️</div>
                <h1 class="h3 fw-bold mb-1">แก้ไขข้อมูลสินค้า</h1>
                <p class="mb-0 opacity-75">อัปเดตรายละเอียดหนังสือ ราคา หมวดหมู่ และสถานะ</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 shadow-sm" role="alert" style="border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <span>กรุณาตรวจสอบข้อมูลให้ถูกต้องครบถ้วน</span>
            </div>
        }

        <!-- Form Card -->
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4">
                <form asp-action="EditProductDetail" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="ExistingCoverPicture" />

                    <!-- ชื่อสินค้า -->
                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label fw-semibold">
                            <i class="bi bi-tag-fill text-primary me-1"></i> ชื่อสินค้า <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ProductName" class="form-control form-control-lg" placeholder="ระบุชื่อสินค้า..." />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                    </div>

                    <!-- รายละเอียด -->
                    <div class="mb-3">
                        <label asp-for="ProductDescription" class="form-label fw-semibold">
                            <i class="bi bi-card-text text-primary me-1"></i> รายละเอียดสินค้า
                        </label>
                        <textarea asp-for="ProductDescription" class="form-control" rows="4"
                                  placeholder="อธิบายรายละเอียดสินค้า..."></textarea>
                        <span asp-validation-for="ProductDescription" class="text-danger small"></span>
                    </div>

                    <!-- ราคา + หมวดหมู่ -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">
                                <i class="bi bi-currency-exchange text-primary me-1"></i> ราคา (บาท) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-cash-coin"></i></span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                <i class="bi bi-folder-fill text-primary me-1"></i> หมวดหมู่
                            </label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="0">-- เลือกหมวดหมู่ --</option>
                                <option value="1">📖 นิยาย / เรื่องสั้น</option>
                                <option value="2">🎓 วิชาการ / การศึกษา</option>
                                <option value="3">💼 ธุรกิจ / การเงิน</option>
                                <option value="4">🌿 สุขภาพ / ไลฟ์สไตล์</option>
                                <option value="5">💻 เทคโนโลยี / IT</option>
                                <option value="6">📦 อื่นๆ</option>
                            </select>
                        </div>
                    </div>

                    <!-- ราคาโปรโมชั่น -->
                    <div class="row g-3 mb-4 p-3 bg-danger bg-opacity-10" style="border-radius: 12px; border: 1px dashed #dc3545;">
                        <div class="col-12 mb-1">
                            <h5 class="text-danger mb-0"><i class="bi bi-fire"></i> ตั้งค่าโปรโมชั่น <small class="text-muted fs-6">(แก้ไขได้ 1 ครั้งต่อวัน)</small></h5>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PromotionPrice" class="form-label fw-semibold text-danger">ราคาโปรโมชั่น (บาท)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-danger text-white"><i class="bi bi-tag-fill"></i></span>
                                <input asp-for="PromotionPrice" type="number" step="0.01" min="0" class="form-control border-danger" placeholder="เว้นว่างไว้หากไม่จัดโปร" />
                            </div>
                            <span asp-validation-for="PromotionPrice" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PromotionEndDate" class="form-label fw-semibold text-danger">สิ้นสุดโปรโมชั่น</label>
                            <input asp-for="PromotionEndDate" type="datetime-local" class="form-control border-danger" />
                        </div>
                        @if (Model.LastPromotionEdit.HasValue)
                        {
                            <div class="col-12 mt-2">
                                <small class="text-muted"><i class="bi bi-clock-history"></i> แก้ไขโปรโมชั่นล่าสุดเมื่อ: @Model.LastPromotionEdit.Value.ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                        }
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                        {
                            <div class="col-12 mt-2">
                                <div class="alert alert-danger py-2 mb-0 border-0 d-flex align-items-center">
                                    <i class="bi bi-exclamation-octagon-fill me-2"></i>
                                    @ViewData.ModelState[""].Errors.First().ErrorMessage
                                </div>
                            </div>
                        }
                    </div>

                    <!-- สถานะ -->
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">
                            <i class="bi bi-toggles text-primary me-1"></i> สถานะการเผยแพร่
                        </label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">✅ เผยแพร่ (Public)</option>
                            <option value="0">🙈 ซ่อน (Hidden)</option>
                        </select>
                    </div>

                    <!-- ไฟล์สินค้า (ไม่อนุญาตให้แก้ไข) -->
                    <div class="mb-3">
                        <div class="alert alert-secondary d-flex align-items-center gap-2 mb-0" role="alert" style="border-radius: 10px;">
                            <i class="bi bi-file-earmark-lock-fill fs-5"></i>
                            <div>
                                <strong>ไฟล์หนังสือ:</strong> ไม่สามารถแก้ไขไฟล์หนังสือได้ (<a asp-action="EditProduct" class="text-decoration-none">ต้องการอัปโหลดใหม่? สร้างเล่มใหม่แทน</a>)
                            </div>
                        </div>
                    </div>

                    <!-- ภาพหน้าปก -->
                    <div class="mb-4">
                        <label asp-for="CoverImage" class="form-label fw-semibold">
                            <i class="bi bi-image-fill text-primary me-1"></i> ภาพหน้าปก (อัปโหลดใหม่เพื่อเปลี่ยน)
                        </label>
                        <div class="upload-drop-zone cover-drop" id="coverDropZone" onclick="document.getElementById('CoverImageInput').click()">
                            <img id="coverPreview" src="@(!string.IsNullOrEmpty(Model.ExistingCoverPicture) ? Model.ExistingCoverPicture : "")" alt="Cover Preview" class="@(string.IsNullOrEmpty(Model.ExistingCoverPicture) ? "d-none" : "")" style="max-height: 120px; border-radius: 8px; object-fit: cover;" />
                            <div id="coverPlaceholder" style="@(!string.IsNullOrEmpty(Model.ExistingCoverPicture) ? "display: none;" : "")">
                                <i class="bi bi-image fs-2 text-primary"></i>
                                <div class="mt-1 fw-semibold">คลิกเพื่อเปลี่ยนภาพปก</div>
                                <small class="text-muted">JPG, PNG, WEBP (หากไม่เลือก ค่าเดิมจะถูกเก็บไว้)</small>
                            </div>
                        </div>
                        <input asp-for="CoverImage" type="file" id="CoverImageInput" accept="image/*" class="d-none" onchange="previewCover(this)" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 align-items-center pt-2 border-top mt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm" style="background: linear-gradient(135deg, #1a3a6e, #29579D); border: none; border-radius: 10px;">
                            <i class="bi bi-save-fill me-2"></i> บันทึกการแก้ไข
                        </button>
                        <a asp-action="EditProduct" class="btn btn-outline-secondary btn-lg px-4" style="border-radius: 10px;">
                            <i class="bi bi-x-circle me-1"></i> ยกเลิก
                        </a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<style>
    .upload-drop-zone {
        border: 2px dashed #c0ccdf;
        border-radius: 12px;
        padding: 24px 16px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.25s, background 0.25s;
        background: #f8faff;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .upload-drop-zone:hover {
        border-color: #29579D;
        background: #eef3fc;
    }

    .upload-drop-zone.cover-drop {
        min-height: 140px;
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewCover(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = document.getElementById('coverPreview');
                    const placeholder = document.getElementById('coverPlaceholder');
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
