@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}
@using singleProject.Models.Db
@using Microsoft.AspNetCore.Http
@model IEnumerable<UserDatum>

<section class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>User Management</h1>
            <p class="text-muted">Manage user accounts and website permissions.</p>
        </div>
        <button id="AddUserBtn" class="btn btn-primary"><i class="bi bi-person-plus-fill me-2"></i>Add New User</button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <table class="table table-hover mb-0 align-middle">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">User ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4"><code class="text-primary fw-bold">@item.UserId</code></td>
                        <td>@item.UserName</td>
                        <td>@item.Email</td>
                        <td>
                            <form asp-action="UpdateRole" method="post" class="d-flex align-items-center gap-2">
                                <input type="hidden" name="userId" value="@item.UserId" />
                                <select name="newRole" class="form-select form-select-sm" style="width: auto;">
                                    <option value="User" selected="@(item.UserRole == "User")">User</option>
                                    <option value="Seller" selected="@(item.UserRole == "Seller")">Seller</option>
                                    <option value="Supporter" selected="@(item.UserRole == "Supporter")">Supporter</option>
                                    <option value="Admin" selected="@(item.UserRole == "Admin")">Admin</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                            </form>
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-light border" title="Edit Profile"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-light border text-danger" title="Delete User"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<style>
  section{
    position: relative;
    margin-top: 6rem;
  }
</style>