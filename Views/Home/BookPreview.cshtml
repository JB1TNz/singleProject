@using Microsoft.AspNetCore.Http
@using singleProject.Models.Db
@model ProductData

@{
    ViewData["Title"] = Model.ProductName ?? "รายละเอียดหนังสือ";

    var role = Context.Session.GetString("Role");
    if (role == "Admin")
    {
        Layout = "_AdminLayout";
    }
    else if (role == "Seller")
    {
        Layout = "_SellerLayout";
    }
    else if (role == "User")
    {
        Layout = "_UserLayout";
    }
    else
    {
        Layout = "_Layout";
    }

    var categoryNames = new Dictionary<int, string>
    {
        { 1, "📖 นิยาย / เรื่องสั้น" },
        { 2, "🎓 วิชาการ / การศึกษา" },
        { 3, "💼 ธุรกิจ / การเงิน" },
        { 4, "🌿 สุขภาพ / ไลฟ์สไตล์" },
        { 5, "💻 เทคโนโลยี / IT" },
        { 6, "📦 อื่นๆ" }
    };

    string categoryLabel = Model.CategoryId.HasValue && categoryNames.ContainsKey(Model.CategoryId.Value)
        ? categoryNames[Model.CategoryId.Value]
        : "📦 อื่นๆ";
}

<div class="preview-wrapper">

    <!-- Back Button -->
    <div class="mb-4">
        <a href="@Url.Action("Index", "Home")" class="btn-back">
            <i class="bi bi-arrow-left-short fs-5"></i> กลับหน้าหลัก
        </a>
    </div>

    <div class="preview-layout">

        <!-- Left: Cover Image -->
        <div class="preview-cover-col">
            <div class="preview-cover-box">
                @if (!string.IsNullOrEmpty(Model.CoverPicture))
                {
                    <img src="@Model.CoverPicture" alt="@Model.ProductName" class="preview-cover-img" />
                }
                else
                {
                    <div class="preview-no-cover">
                        <span class="no-cover-icon-lg">📖</span>
                        <span class="no-cover-label">ไม่พบปกหนังสือ</span>
                    </div>
                }
            </div>

            <!-- Purchase Card -->
            <div class="purchase-card">
                <div class="purchase-price">฿@Model.Price?.ToString("N2")</div>
                <p class="purchase-note"><i class="bi bi-lightning-fill text-warning me-1"></i>ดาวน์โหลดได้ทันทีหลังชำระเงิน</p>

                @if (Context.Session.GetString("Role") == "Seller")
                {
                    <div class="alert alert-warning mb-0 text-center" style="font-size: 0.85rem; border-radius: 12px;">
                        <i class="bi bi-exclamation-circle-fill me-1"></i> บัญชีผู้ขายไม่สามารถสั่งซื้อหนังสือได้
                    </div>
                }
                else if (Context.Session.GetString("UserId") != null)
                {
                    @if (ViewBag.AlreadyOwned == true)
                    {
                        <a href="@Url.Action("MyLibrary", "Home")" class="btn-buy" style="background: #16a34a;">
                            <i class="bi bi-book-half me-2"></i>อ่านหนังสือเล่มนี้
                        </a>
                    }
                    else
                    {
                        <form asp-controller="Home" asp-action="BuyBook" method="post">
                            <input type="hidden" name="id" value="@Model.ProductId" />
                            <button type="submit" class="btn-buy">
                                <i class="bi bi-bag-check-fill me-2"></i>ซื้อหนังสือเล่มนี้
                            </button>
                        </form>
                    }
                }
                else
                {
                    <a class="btn-buy" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-person-fill me-2"></i>เข้าสู่ระบบเพื่อซื้อ
                    </a>
                }

                <div class="purchase-meta">
                    <div><i class="bi bi-shield-check text-success me-1"></i>ชำระเงินปลอดภัย 100%</div>
                    <div><i class="bi bi-arrow-counterclockwise text-primary me-1"></i>รับประกันคืนเงิน 7 วัน</div>
                </div>
            </div>
        </div>

        <!-- Right: Book Detail -->
        <div class="preview-detail-col">
            <div class="book-badge-row">
                <span class="badge-category">@categoryLabel</span>
                <span class="badge-new"><i class="bi bi-stars me-1"></i>ใหม่</span>
            </div>

            <h1 class="preview-title">@Model.ProductName</h1>

            <div class="preview-meta-row">
                <div class="meta-item">
                    <i class="bi bi-calendar3 text-primary me-1"></i>
                    <span>เพิ่มเมื่อ @Model.CreatedDate?.ToString("dd MMM yyyy")</span>
                </div>
                <div class="meta-item">
                    <i class="bi bi-globe text-success me-1"></i>
                    <span>พร้อมดาวน์โหลด</span>
                </div>
            </div>

            <div class="divider"></div>

            <h2 class="detail-section-title">รายละเอียดหนังสือ</h2>
            <p class="preview-description">
                @(string.IsNullOrWhiteSpace(Model.ProductDescription) ? "ยังไม่มีรายละเอียดสำหรับหนังสือเล่มนี้" : Model.ProductDescription)
            </p>

            <div class="divider"></div>

            <!-- Feature Highlights -->
            <div class="feature-grid">
                <div class="feature-item">
                    <i class="bi bi-file-earmark-arrow-down-fill feature-icon"></i>
                    <div>
                        <div class="feature-label">ดาวน์โหลดทันที</div>
                        <div class="feature-sub">ได้รับไฟล์ทันทีหลังชำระ</div>
                    </div>
                </div>
                <div class="feature-item">
                    <i class="bi bi-devices feature-icon"></i>
                    <div>
                        <div class="feature-label">อ่านได้ทุกอุปกรณ์</div>
                        <div class="feature-sub">PC, Tablet, มือถือ</div>
                    </div>
                </div>
                <div class="feature-item">
                    <i class="bi bi-infinity feature-icon"></i>
                    <div>
                        <div class="feature-label">ไม่มีวันหมดอายุ</div>
                        <div class="feature-sub">เข้าถึงตลอดชีพ</div>
                    </div>
                </div>
                <div class="feature-item">
                    <i class="bi bi-translate feature-icon"></i>
                    <div>
                        <div class="feature-label">ภาษาไทย</div>
                        <div class="feature-sub">เนื้อหาภาษาไทยล้วน</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Buy Success Modal -->
<div class="modal-overlay" id="buyModal" style="display:none;">
    <div class="modal-box">
        <div class="modal-icon">🎉</div>
        <h3>ขอบคุณที่ซื้อหนังสือ!</h3>
        <p>คำสั่งซื้อของคุณกำลังดำเนินการ<br />คุณจะได้รับลิงก์ดาวน์โหลดเร็วๆ นี้</p>
        <button class="btn-modal-close" onclick="document.getElementById('buyModal').style.display='none'">ปิด</button>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap');

    .preview-wrapper {
        font-family: 'Sarabun', sans-serif;
        max-width: 1100px;
        margin: 0 auto;
        padding: 36px 24px 60px;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        color: #29579D;
        font-weight: 600;
        text-decoration: none;
        background: #eef3fc;
        padding: 8px 18px;
        border-radius: 50px;
        font-size: 0.9rem;
        transition: background 0.2s, transform 0.2s;
    }

    .btn-back:hover {
        background: #dde8fb;
        transform: translateX(-3px);
        color: #1a3a6e;
    }

    /* Layout */
    .preview-layout {
        display: flex;
        gap: 40px;
        align-items: flex-start;
    }

    /* Cover Column */
    .preview-cover-col {
        width: 280px;
        flex-shrink: 0;
        position: sticky;
        top: 80px;
    }

    .preview-cover-box {
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(41,87,157,0.2);
        margin-bottom: 20px;
        aspect-ratio: 2/3;
        background: #e8f0fe;
    }

    .preview-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .preview-no-cover {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #dde8fb, #c7d7f8);
        gap: 10px;
    }

    .no-cover-icon-lg { font-size: 4rem; }

    .no-cover-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #29579D;
        text-align: center;
        padding: 0 16px;
    }

    /* Purchase Card */
    .purchase-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .purchase-price {
        font-size: 2rem;
        font-weight: 700;
        color: #16a34a;
        margin-bottom: 6px;
    }

    .purchase-note {
        font-size: 0.8rem;
        color: #6b7280;
        margin-bottom: 16px;
    }

    .btn-buy {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 13px 20px;
        background: linear-gradient(135deg, #29579D, #1a3a6e);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 700;
        font-family: 'Sarabun', sans-serif;
        cursor: pointer;
        text-decoration: none;
        margin-bottom: 10px;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 18px rgba(41,87,157,0.35);
    }

    .btn-buy:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(41,87,157,0.5);
        color: #fff;
    }

    .btn-cart {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 11px 20px;
        background: transparent;
        color: #29579D;
        border: 2px solid #29579D;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 16px;
        transition: all 0.2s;
    }

    .btn-cart:hover {
        background: #29579D;
        color: #fff;
    }

    .purchase-meta {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 0.8rem;
        color: #6b7280;
    }

    /* Detail Column */
    .preview-detail-col { flex: 1; }

    .book-badge-row {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .badge-category {
        background: #eef3fc;
        color: #29579D;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 4px 14px;
        border-radius: 50px;
    }

    .badge-new {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 50px;
    }

    .preview-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a2e;
        line-height: 1.3;
        margin-bottom: 16px;
    }

    .preview-meta-row {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .meta-item {
        font-size: 0.88rem;
        color: #6b7280;
        display: flex;
        align-items: center;
    }

    .divider {
        height: 1px;
        background: #e2e8f0;
        margin: 24px 0;
    }

    .detail-section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 12px;
    }

    .preview-description {
        font-size: 0.97rem;
        color: #374151;
        line-height: 1.8;
        white-space: pre-line;
    }

    /* Feature Grid */
    .feature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: #f8faff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px;
    }

    .feature-icon {
        font-size: 1.4rem;
        color: #29579D;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .feature-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: #1a1a2e;
    }

    .feature-sub {
        font-size: 0.78rem;
        color: #6b7280;
        margin-top: 2px;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .modal-box {
        background: #fff;
        border-radius: 20px;
        padding: 40px 32px;
        text-align: center;
        max-width: 360px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        animation: popIn 0.3s ease;
    }

    @@keyframes popIn {
        from { transform: scale(0.8); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-icon { font-size: 3.5rem; margin-bottom: 16px; }

    .modal-box h3 {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: #1a1a2e;
    }

    .modal-box p {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .btn-modal-close {
        background: linear-gradient(135deg, #29579D, #1a3a6e);
        color: #fff;
        border: none;
        padding: 11px 32px;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'Sarabun', sans-serif;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .btn-modal-close:hover { transform: translateY(-2px); }

    @@media (max-width: 768px) {
        .preview-layout { flex-direction: column; }
        .preview-cover-col { width: 100%; position: static; }
        .preview-cover-box { max-width: 240px; margin: 0 auto 20px; }
        .preview-title { font-size: 1.5rem; }
        .feature-grid { grid-template-columns: 1fr; }
    }
</style>

@section Scripts {

}
