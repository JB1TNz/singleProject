@model singleProject.ViewModels.LoginViewModel;
@{
  ViewData["Title"] = "Login";
  Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - BestEBook</title>
  <link rel="stylesheet" href="./Login.css" asp-append-version="true" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<section class="auth-wrapper">
  <!-- Left Side: 60% with Background Image -->
  <div class="auth-left">
    <div class="auth-info-overlay">
      <div class="auth-info">
        <h2>Discover Your Next<br>Favorite E-Book</h2>
        <p>Explore thousands of titles, enjoy instant downloads, and read anytime, anywhere. Build your digital library today.</p>
      </div>
    </div>
  </div>

  <!-- Right Side: 40% with Form -->
  <div class="auth-right">
    <div class="auth-card">
      <!-- LOGIN -->
      <div id="loginBox">
        <h1 class="auth-title">Welcome @(ViewBag.Username ?? "Back")</h1>
        <p class="auth-subtitle">Log in to access your e-book library.</p>

        <form class="auth-form" asp-controller="Account" asp-action="Login" method="post">
          <div class="form-group">
            <label>Username</label>
            <input type="text" placeholder="Enter your username" asp-for="Username" required>
          </div>

          <div class="form-group">
            <label>Password</label>
            <input type="password" placeholder="Enter your password" asp-for="Password" required>
          </div>

          <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <p class="switch-text">
          Don't have an account?
          <span onclick="showRegister()">Register here</span>
        </p>
      </div>

      <!-- REGISTER -->
      <div id="registerBox" class="hidden">
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Join us and start building your digital collection.</p>

        <form class="auth-form" asp-controller="Account" asp-action="Register" method="post">
          <div class="form-group">
            <label>Username</label>
            <input type="text" name="UserName" placeholder="Choose a username" required>
          </div>

          <div class="form-group">
            <label>Email</label>
            <input type="email" name="Email" placeholder="Enter your email" required>
          </div>

          <div class="form-group">
            <label>Password</label>
            <input type="password" name="UserPassword" placeholder="Create a password" required>
          </div>

          <button type="submit" class="btn-primary">Sign Up</button>
        </form>

        <p class="switch-text">
          Already have an account?
          <span onclick="showLogin()">Log in</span>
        </p>
      </div>

    </div>
  </div>
</section>

<script>
  function showRegister() {
    document.getElementById('loginBox').classList.add('hidden');
    document.getElementById('registerBox').classList.remove('hidden');
  }

  function showLogin() {
    document.getElementById('registerBox').classList.add('hidden');
    document.getElementById('loginBox').classList.remove('hidden');
  }

  @if (ViewBag.ErrorMessage != null)
  {
      <text>
      window.onload = function() {
          alert('@ViewBag.ErrorMessage');
      };
      </text>
  }
</script>

<style>
/* Reset and Font */
body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: #ffffff;
}

/* Layout */
.auth-wrapper {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

/* 60% Left Section */
.auth-left {
  flex: 0 0 60%;
  /* TODO: Update the url below with your own background image */
  background-image: url('https://images.pexels.com/photos/3646172/pexels-photo-3646172.jpeg');
  background-size: cover;
  background-position: center;
  position: relative;
}

/* Overlay to darken background image and make text pop */
.auth-info-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(26, 31, 53, 0.75) 0%, rgba(41, 87, 157, 0.75) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

.auth-info {
  text-align: center;
  color: #ffffff;
  max-width: 600px;
}

.auth-info h2 {
  font-size: 3.2rem;
  font-weight: 700;
  margin-bottom: 24px;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.auth-info p {
  font-size: 1.15rem;
  font-weight: 300;
  color: rgba(255,255,255,0.9);
  line-height: 1.6;
}

/* 40% Right Section */
.auth-right {
  flex: 0 0 40%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px;
  background: #ffffff;
}

/* Form Container */
.auth-card {
  width: 100%;
  max-width: 380px;
}

.auth-title {
  font-size: 2rem;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8px;
}

.auth-subtitle {
  font-size: 0.95rem;
  color: #6b7280;
  margin-bottom: 32px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8px;
}

.form-group input {
  padding: 14px 16px;
  border-radius: 8px;
  border: 1px solid #d1d5db;
  font-size: 0.95rem;
  transition: all 0.2s ease;
  background: #f9fafb;
}

.form-group input:focus {
  outline: none;
  border-color: #29579D;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(41, 87, 157, 0.1);
}

.btn-primary {
  margin-top: 12px;
  padding: 14px 16px;
  border: none;
  border-radius: 8px;
  background: #29579D;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
}

.btn-primary:hover {
  background: #1a3a6e;
}

.btn-primary:active {
  transform: scale(0.98);
}

.switch-text {
  text-align: center;
  margin-top: 32px;
  font-size: 0.9rem;
  color: #6b7280;
}

.switch-text span {
  color: #29579D;
  font-weight: 600;
  cursor: pointer;
  transition: color 0.2s;
  margin-left: 4px;
}

.switch-text span:hover {
  color: #1a3a6e;
  text-decoration: underline;
}

.hidden {
  display: none !important;
}

/* Animations */
@@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

#loginBox, #registerBox {
  animation: fadeIn 0.4s ease;
}

/* Responsive */
@@media (max-width: 900px) {
  .auth-wrapper {
    flex-direction: column;
  }
  .auth-left {
    flex: 0 0 auto;
    min-height: 40vh;
  }
  .auth-right {
    flex: 1 1 auto;
    padding: 60px 20px;
  }
}
</style>
</body>
</html>
