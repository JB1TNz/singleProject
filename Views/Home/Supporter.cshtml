@{
    ViewData["Title"] = "Customer Service & Supporter";
        var role = Context.Session.GetString("Role");
    if (role == "Admin")
    {
        Layout = "_AdminLayout";
    }
    else if (role == "Seller")
    {
        Layout = "_SellerLayout";
    }
    else if (role == "Supporter")
    {
        Layout = "_SupporterLayout";
    }
    else if (role == "User")
    {
        Layout = "_UserLayout";
    }
    else
    {
        Layout = "_Layout";
    }

}

<div class="container py-5 mt-4">
    <div class="row text-center mb-5">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-primary"><i class="bi bi-headset"></i> ศูนย์ช่วยเหลือและบริการลูกค้า</h1>
            <p class="lead text-muted">มีคำถาม แจ้งปัญหาลิขสิทธิ์ หรือสอบถามโปรโมชั่น? ทีมงานของเราพร้อมดูแลคุณเสมอ</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 py-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close mt-1" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white p-4 border-0">
                    <h4 class="mb-0"><i class="bi bi-envelope-paper-fill me-2"></i> ฟอร์มติดต่อทีมงาน</h4>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger rounded-3">กรุณากรอกข้อมูลให้ครบถ้วน</div>
                    }

                    <form asp-action="Supporter" method="post">
                        <div class="mb-4">
                            <label for="topic" class="form-label fw-bold">หัวข้อที่ต้องการติดต่อ <span class="text-danger">*</span></label>
                            <select name="topic" id="topic" class="form-select form-select-lg" required>
                                <option value="" selected disabled>-- เลือกหัวข้อ --</option>
                                <option value="สอบถามข้อมูลหนังสือ">สอบถามข้อมูลหนังสือ</option>
                                <option value="สอบถามโปรโมชั่น/ส่วนลด">สอบถามโปรโมชั่น/ส่วนลด</option>
                                <option value="แจ้งปัญหาการใช้งานเว็บไซต์">แจ้งปัญหาการใช้งานเว็บไซต์</option>
                                <option value="แจ้งปัญหาด้านการชำระเงิน">แจ้งปัญหาด้านการชำระเงิน</option>
                                <option value="แจ้งละเมิดลิขสิทธิ์">แจ้งละเมิดลิขสิทธิ์เนื้อหา</option>
                                <option value="เรื่องอื่นๆ">เรื่องอื่นๆ</option>
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label for="description" class="form-label fw-bold">รายละเอียด <span class="text-danger">*</span></label>
                            <textarea name="description" id="description" class="form-control" rows="5" placeholder="อธิบายรายละเอียดปัญหา หรือสิ่งที่ต้องการสอบถาม..." required></textarea>
                            <div class="form-text mt-2"><i class="bi bi-info-circle"></i> หากเป็นการแจ้งลิขสิทธิ์ กรุณาระบุชื่อผู้แต่ง และลิงก์หนังสืออ้างอิงให้ชัดเจน</div>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                <i class="bi bi-send-fill me-2"></i> ส่งข้อความถึงทีมงาน
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="row mt-5 text-center">
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light rounded-4 h-100">
                        <i class="bi bi-clock-history fs-1 text-primary mb-2"></i>
                        <h5 class="fw-bold">เวลาทำการ</h5>
                        <p class="text-muted small mb-0">จันทร์ - ศุกร์<br>09:00 น. - 18:00 น.</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light rounded-4 h-100">
                        <i class="bi bi-envelope-at fs-1 text-primary mb-2"></i>
                        <h5 class="fw-bold">อีเมล</h5>
                        <p class="text-muted small mb-0">support<br/>@("bestebook.com")</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="p-3 bg-light rounded-4 h-100">
                        <i class="bi bi-chat-dots fs-1 text-primary mb-2"></i>
                        <h5 class="fw-bold">ระยะเวลาตอบกลับ</h5>
                        <p class="text-muted small mb-0">ปกติทีมงานจะตอบกลับภายใน 24 ชม.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
