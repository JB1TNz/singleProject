@{
    ViewData["Title"] = "Dashboard - Seller";
    Layout = "_SellerLayout";
}
@model IEnumerable<dynamic>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold" style="color: #29579D;">
            <i class="bi bi-speedometer2 me-2"></i>ภาพรวมระบบ (Dashboard)
        </h2>
        <a asp-action="UploadProduct" class="btn btn-primary px-4 py-2" style="background: #29579D; border: none; border-radius: 12px;">
            <i class="bi bi-plus-circle me-1"></i> อัพโหลดเพิ่ม
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: linear-gradient(135deg, #29579D, #1a3a6e); color: white;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="fs-1 me-4 opacity-75"><i class="bi bi-book-half"></i></div>
                    <div>
                        <h6 class="mb-1 opacity-75">จำนวนหนังสือทั้งหมด</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.TotalProducts <small class="fs-6 fw-normal">เล่ม</small></h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: linear-gradient(135deg, #16a34a, #14532d); color: white;">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="fs-1 me-4 opacity-75"><i class="bi bi-cloud-arrow-down-fill"></i></div>
                    <div>
                        <h6 class="mb-1 opacity-75">ยอดดาวน์โหลด/ซื้อรวม</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.TotalDownloads <small class="fs-6 fw-normal">ครั้ง</small></h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
            <h5 class="fw-bold text-dark"><i class="bi bi-bar-chart-fill text-primary me-2"></i>สถิติหนังสือแต่ละเล่ม</h5>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light text-muted">
                        <tr>
                            <th>หนังสือ</th>
                            <th>ราคา</th>
                            <th class="text-center">ยอดดาวน์โหลด/ซื้อ (ครั้ง)</th>
                            <th class="text-center">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-4 d-block mb-2"></i> ยังไม่มีข้อมูลหนังสือ
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.Product.CoverPicture))
                                            {
                                                <img src="@item.Product.CoverPicture" style="width: 40px; height: 50px; object-fit: cover; border-radius: 4px;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light text-center rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 50px;">
                                                    <i class="bi bi-book text-muted"></i>
                                                </div>
                                            }
                                            <span class="fw-semibold text-dark">@item.Product.ProductName</span>
                                        </div>
                                    </td>
                                    <td>฿@item.Product.Price?.ToString("N2")</td>
                                    <td class="text-center fw-bold text-success">
                                        @item.DownloadCount
                                    </td>
                                    <td class="text-center">
                                        @if (item.Product.Status == 1)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">เผยแพร่</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">ซ่อน</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
