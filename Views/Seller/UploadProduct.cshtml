@using Microsoft.AspNetCore.Http
@model singleProject.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "อัพโหลดสินค้า";
    Layout = "_SellerLayout";
}

<div class="upload-wrapper">
    <div class="upload-card">
        <div class="upload-header">
            <div class="upload-icon">📦</div>
            <h1 class="upload-title">อัพโหลดสินค้าใหม่</h1>
            <p class="upload-subtitle">กรอกข้อมูลสินค้าให้ครบถ้วนแล้วกดอัพโหลด</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">
                <span>✅</span> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="UploadProduct" method="post" enctype="multipart/form-data" class="upload-form">
            @Html.AntiForgeryToken()

            <div class="form-row">
                <!-- ชื่อสินค้า -->
                <div class="form-group full">
                    <label asp-for="ProductName" class="form-label">
                        <span class="label-icon">🏷️</span> ชื่อสินค้า <span class="required">*</span>
                    </label>
                    <input asp-for="ProductName" class="form-control" placeholder="ระบุชื่อสินค้า..." />
                    <span asp-validation-for="ProductName" class="validation-msg"></span>
                </div>

                <!-- รายละเอียด -->
                <div class="form-group full">
                    <label asp-for="ProductDescription" class="form-label">
                        <span class="label-icon">📝</span> รายละเอียดสินค้า
                    </label>
                    <textarea asp-for="ProductDescription" class="form-control" rows="4"
                              placeholder="อธิบายรายละเอียดสินค้า..."></textarea>
                    <span asp-validation-for="ProductDescription" class="validation-msg"></span>
                </div>

                <!-- ราคา -->
                <div class="form-group half">
                    <label asp-for="Price" class="form-label">
                        <span class="label-icon">💰</span> ราคา (บาท) <span class="required">*</span>
                    </label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Price" class="validation-msg"></span>
                </div>

                <!-- หมวดหมู่ -->
                <div class="form-group half">
                    <label asp-for="CategoryId" class="form-label">
                        <span class="label-icon">📂</span> หมวดหมู่
                    </label>
                    <select asp-for="CategoryId" class="form-control">
                        <option value="0">-- เลือกหมวดหมู่ --</option>
                        <option value="1">นิยาย / เรื่องสั้น</option>
                        <option value="2">วิชาการ / การศึกษา</option>
                        <option value="3">ธุรกิจ / การเงิน</option>
                        <option value="4">สุขภาพ / ไลฟ์สไตล์</option>
                        <option value="5">เทคโนโลยี / IT</option>
                        <option value="6">อื่นๆ</option>
                    </select>
                </div>

                <!-- สถานะ -->
                <div class="form-group half">
                    <label asp-for="Status" class="form-label">
                        <span class="label-icon">🔖</span> สถานะ
                    </label>
                    <select asp-for="Status" class="form-control">
                        <option value="1">เผยแพร่</option>
                        <option value="0">ซ่อน</option>
                    </select>
                </div>

                <!-- ไฟล์สินค้า -->
                <div class="form-group half">
                    <label asp-for="File" class="form-label">
                        <span class="label-icon">📎</span> ไฟล์สินค้า (PDF/ZIP...) <span class="required">*</span>
                    </label>
                    <div class="file-drop" id="fileDropZone" onclick="document.getElementById('File').click()">
                        <div class="file-drop-icon">⬆️</div>
                        <div class="file-drop-text" id="fileDropText">คลิกหรือลากไฟล์มาวางที่นี่</div>
                    </div>
                    <input asp-for="File" type="file" id="File" class="hidden-file-input"
                           onchange="updateFileLabel(this, 'fileDropText')" />
                    <span asp-validation-for="File" class="validation-msg"></span>
                </div>

                <!-- ภาพหน้าปก -->
                <div class="form-group half">
                    <label asp-for="CoverImage" class="form-label">
                        <span class="label-icon">🖼️</span> ภาพหน้าปก (JPG/PNG)
                    </label>
                    <div class="file-drop cover-drop" id="coverDropZone" onclick="document.getElementById('CoverImage').click()">
                        <div class="cover-preview-wrapper">
                            <img id="coverPreview" src="" alt="" class="cover-preview hidden" />
                            <div id="coverPlaceholder">
                                <div class="file-drop-icon">🖼️</div>
                                <div class="file-drop-text">คลิกเพื่อเลือกภาพปก</div>
                            </div>
                        </div>
                    </div>
                    <input asp-for="CoverImage" type="file" id="CoverImage" accept="image/*"
                           class="hidden-file-input" onchange="previewCover(this)" />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-upload">
                    <span>🚀</span> อัพโหลดสินค้า
                </button>
                <a href="/" class="btn-cancel">ยกเลิก</a>
            </div>
        </form>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body { font-family: 'Sarabun', sans-serif; }

    .upload-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        padding: 40px 20px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .upload-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 24px;
        padding: 48px;
        width: 100%;
        max-width: 860px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
    }

    .upload-header { text-align: center; margin-bottom: 36px; }

    .upload-icon { font-size: 3rem; margin-bottom: 12px; }

    .upload-title {
        font-size: 1.9rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
    }

    .upload-subtitle { color: rgba(255,255,255,0.5); font-size: 0.95rem; }

    .alert-success {
        background: rgba(72, 199, 116, 0.15);
        border: 1px solid rgba(72, 199, 116, 0.4);
        color: #48c774;
        padding: 14px 20px;
        border-radius: 12px;
        margin-bottom: 28px;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .form-row { display: flex; flex-wrap: wrap; gap: 20px; }

    .form-group { display: flex; flex-direction: column; }
    .form-group.full  { width: 100%; }
    .form-group.half  { flex: 1 1 calc(50% - 10px); min-width: 220px; }

    .form-label {
        color: rgba(255,255,255,0.75);
        font-size: 0.88rem;
        font-weight: 600;
        margin-bottom: 8px;
        letter-spacing: 0.3px;
    }

    .label-icon { margin-right: 4px; }
    .required { color: #ff6b6b; margin-left: 2px; }

    .form-control {
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 10px;
        padding: 12px 16px;
        color: #fff;
        font-family: 'Sarabun', sans-serif;
        font-size: 0.95rem;
        transition: border-color 0.25s, box-shadow 0.25s;
        width: 100%;
    }

    .form-control:focus {
        outline: none;
        border-color: #7c5cbf;
        box-shadow: 0 0 0 3px rgba(124, 92, 191, 0.25);
    }

    .form-control option { background: #2d2b55; color: #fff; }

    textarea.form-control { resize: vertical; min-height: 100px; }

    .hidden-file-input { display: none; }

    .file-drop {
        background: rgba(255, 255, 255, 0.05);
        border: 2px dashed rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 28px 16px;
        text-align: center;
        cursor: pointer;
        transition: border-color 0.25s, background 0.25s;
        min-height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

    .file-drop:hover {
        border-color: #7c5cbf;
        background: rgba(124, 92, 191, 0.08);
    }

    .file-drop-icon { font-size: 1.8rem; margin-bottom: 6px; }

    .file-drop-text { color: rgba(255,255,255,0.5); font-size: 0.85rem; }

    .cover-drop { min-height: 130px; padding: 12px; }

    .cover-preview-wrapper { width: 100%; }

    .cover-preview {
        max-width: 100%;
        max-height: 120px;
        border-radius: 8px;
        object-fit: cover;
    }

    .cover-preview.hidden { display: none; }

    .validation-msg { color: #ff6b6b; font-size: 0.8rem; margin-top: 5px; }

    .form-actions {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-top: 32px;
    }

    .btn-upload {
        background: linear-gradient(135deg, #7c5cbf, #a855f7);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 14px 34px;
        font-size: 1rem;
        font-weight: 600;
        font-family: 'Sarabun', sans-serif;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 20px rgba(124, 92, 191, 0.35);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-upload:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(124, 92, 191, 0.5);
    }

    .btn-cancel {
        color: rgba(255,255,255,0.5);
        text-decoration: none;
        font-size: 0.92rem;
        transition: color 0.2s;
    }

    .btn-cancel:hover { color: #fff; }

    @@media (max-width: 600px) {
        .upload-card { padding: 28px 20px; }
        .form-group.half { flex: 1 1 100%; }
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function updateFileLabel(input, textId) {
            const el = document.getElementById(textId);
            if (input.files && input.files.length > 0) {
                el.textContent = input.files[0].name;
                el.style.color = '#a855f7';
            }
        }

        function previewCover(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = document.getElementById('coverPreview');
                    const placeholder = document.getElementById('coverPlaceholder');
                    img.src = e.target.result;
                    img.classList.remove('hidden');
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}