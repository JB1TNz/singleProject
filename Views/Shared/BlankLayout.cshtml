<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - singleProject</title>
  <script type="importmap"></script>
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/singleProject.styles.css" asp-append-version="true" />
</head>

<body>
  <header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
      <div class="container-fluid">
        <a class="navbar-brand text-white font-bold" asp-area="" asp-controller="Home" asp-action="Index">BestEBook</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>
    </nav>
  </header>
  <div class="container">
    <main role="main" class="pb-3">
      @RenderBody()
    </main>
  </div>

  <footer class="border-top footer text-muted box-shadow mt-3">
    <div class="container bg-[#29579D] text-white text-center py-3">
      &copy; 2026 - singleProject
    </div>
  </footer>
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>


@* Css Section *@

<style>
  a.navbar-brand {
    white-space: normal;
    text-align: center;
    word-break: break-all;
    color: #ffffff;
  }

  a {
    color: #0077cc;
  }

  .btn-primary {
    color: #fff;
    background-color: #1b6ec2;
    border-color: #1861ac;
  }

  .nav-pills .nav-link.active,
  .nav-pills .show>.nav-link {
    color: #fff;
    background-color: #1b6ec2;
    border-color: rgb(41, 87, 157, 0.5);
  }

  .navbar {
    background-color: #29579D;
  }

  .navbar-nav .nav-link {
    color: #ffffff;
  }

  .border-top {
    border-top: 1px solid #e5e5e5;
  }

  .border-bottom {
    border-bottom: 1px solid #e5e5e5;
  }

  .box-shadow {
    box-shadow: 0 .25rem .75rem #29579D;
  }

  button.accept-policy {
    font-size: 1rem;
    line-height: inherit;
  }

  .footer {
    position: absolute;
    bottom: 0;
    width: 100%;
    white-space: nowrap;
    line-height: 60px;
    background-color: #29579D;
  }

  .Login {
    position: absolute;
    right: 10px;
  }

  .UserLists {
    position: absolute;
    right: 80px;
  }
</style>

</html>