@using Microsoft.AspNetCore.Http
@using singleProject.Models.Db
@model List<ProductData>

@{
    ViewData["Title"] = "Home - BestEBook";

    var role = Context.Session.GetString("Role");
    if (role == "Admin")
    {
        Layout = "_AdminLayout";
    }
    else if (role == "Seller")
    {
        Layout = "_SellerLayout";
    }
    else if (role == "Supporter")
    {
        Layout = "_SupporterLayout";
    }
    else if (role == "User")
    {
        Layout = "_UserLayout";
    }
    else
    {
        Layout = "_Layout"; // Guest layout
    }

    var categoryNames = new Dictionary<int, string>
    {
        { 1, "นิยาย / เรื่องสั้น" },
        { 2, "วิชาการ / การศึกษา" },
        { 3, "ธุรกิจ / การเงิน" },
        { 4, "สุขภาพ / ไลฟ์สไตล์" },
        { 5, "เทคโนโลยี / IT" },
        { 6, "อื่นๆ" }
    };
}

<main class="ebook-home">

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="hero-content">
            <p class="hero-welcome">
                Welcome
                @if (Context.Session.GetString("Username") != null)
                {
                    <strong>@Context.Session.GetString("Username")</strong>
                }
                else if (ViewBag.Username != null)
                {
                    <strong>@ViewBag.Username</strong>
                }
                else
                {
                    <span>Guest</span>
                }
            </p>
            <h1 class="hero-title">Discover Your Next<br />Favorite E-Book</h1>
            <p class="hero-sub">Thousands of titles. Instant download. Read anytime, anywhere.</p>
            <a href="#featured-section" class="btn-hero">
                <i class="bi bi-search me-2"></i>Browse Collection
            </a>
        </div>
        <div class="hero-illustration">
            <div class="hero-book-stack">
                <div class="hero-book b1"><img src="@Url.Content("~/Content/image/Book2.png")" alt="Book" class="hero-img"></div>
                <div class="hero-book b2"><img src="@Url.Content("~/Content/image/Book.png")" alt="Book" class="hero-img"></div>
                <div class="hero-book b3"><img src="@Url.Content("~/Content/image/Book3.png")" alt="Book" class="hero-img"></div>
            </div>
        </div>
    </section>
    <!-- Promotions Section -->
    @if (ViewBag.PromotedBooks != null && ((List<ProductData>)ViewBag.PromotedBooks).Any())
    {
        <section class="featured-section bg-danger bg-opacity-10 py-5 rounded-4 mb-5" style="border: 2px dashed #dc3545;">
            <div class="section-header px-4">
                <h2 class="section-title text-danger fw-bold"><i class="bi bi-fire me-2"></i>🔥 โปรโมชั่นพิเศษ วันนี้เท่านั้น!</h2>
                <p class="section-sub text-danger opacity-75">ลดราคาแรงสุดในรอบวัน ห้ามพลาดเด็ดขาด</p>
            </div>
            <div class="book-grid px-4">
                @foreach (var book in (List<ProductData>)ViewBag.PromotedBooks)
                {
                    <a href="@Url.Action("BookPreview", "Home", new { id = book.ProductId })" class="book-card-link">
                        <div class="book-card border-danger shadow-sm">
                            <div class="position-absolute top-0 end-0 bg-danger text-white px-3 py-1 rounded-bl-3 rounded-tr-3 fw-bold z-1 shadow" style="border-bottom-left-radius: 12px; border-top-right-radius: 16px;">
                                ลดพิเศษ
                            </div>
                            <!-- Cover Image -->
                            <div class="book-cover">
                                @if (!string.IsNullOrEmpty(book.CoverPicture))
                                {
                                    <img src="@book.CoverPicture" alt="@book.ProductName" class="book-cover-img" />
                                }
                                else
                                {
                                    <div class="book-no-cover"><span class="no-cover-icon">:(</span></div>
                                }
                            </div>
                            <!-- Book Info -->
                            <div class="book-info">
                                <h3 class="book-title text-danger">@book.ProductName</h3>
                                <p class="book-desc">@(book.ProductDescription?.Length > 60 ? book.ProductDescription[..60] + "..." : book.ProductDescription ?? "-")</p>
                                <div class="book-footer">
                                    <div>
                                        <div class="small text-muted text-decoration-line-through">฿@book.Price?.ToString("N2")</div>
                                        <div class="book-price text-danger fs-5 fw-bold">฿@book.PromotionPrice?.ToString("N2")</div>
                                    </div>
                                    <span class="btn-view-detail text-danger">ไปช้อปเลย <i class="bi bi-cart"></i></span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <!-- Featured Books from DB -->
    <section class="featured-section" id="featured-section">
        <div class="section-header">
            <h2 class="section-title"><i class="bi bi-stars me-2 text-warning"></i>หนังสือแนะนำ</h2>
            <p class="section-sub">อัพเดตล่าสุดจากคลังหนังสือของเรา</p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📚</div>
                <h3>ยังไม่มีหนังสือในระบบ</h3>
                <p class="text-muted">เร็วๆ นี้จะมีหนังสือมาให้เลือกอ่าน</p>
            </div>
        }
        else
        {
            <div class="book-grid">
                @foreach (var book in Model)
                {
                    <a href="@Url.Action("BookPreview", "Home", new { id = book.ProductId })" class="book-card-link">
                        <div class="book-card">
                            <!-- Cover Image -->
                            <div class="book-cover">
                                @if (!string.IsNullOrEmpty(book.CoverPicture))
                                {
                                    <img src="@book.CoverPicture" alt="@book.ProductName" class="book-cover-img" />
                                }
                                else
                                {
                                    <div class="book-no-cover">
                                        <span class="no-cover-icon">:(</span>
                                        <span class="no-cover-text">ไม่พบปกหนังสือ</span>
                                    </div>
                                }
                            </div>
                            <!-- Book Info -->
                            <div class="book-info">
                                <div class="book-category">
                                    @(book.CategoryId.HasValue && categoryNames.ContainsKey(book.CategoryId.Value)
                                        ? categoryNames[book.CategoryId.Value]
                                        : "อื่นๆ")
                                </div>
                                <h3 class="book-title">@book.ProductName</h3>
                                <p class="book-desc">@(book.ProductDescription?.Length > 80 ? book.ProductDescription[..80] + "..." : book.ProductDescription ?? "-")</p>
                                <div class="book-footer">
                                    @if (book.PromotionPrice != null && book.PromotionEndDate >= DateTime.Now)
                                    {
                                        <div>
                                            <span class="small text-muted text-decoration-line-through me-1">฿@book.Price?.ToString("N2")</span>
                                            <span class="book-price text-danger">฿@book.PromotionPrice?.ToString("N2")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="book-price">฿@book.Price?.ToString("N2")</span>
                                    }
                                    <span class="btn-view-detail">ดูรายละเอียด <i class="bi bi-arrow-right-short"></i></span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

    <!-- Categories Section -->
    <section class="categories-section">
        <h2 class="section-title"><i class="bi bi-grid-fill me-2 text-primary"></i>หมวดหมู่ยอดนิยม</h2>
        <div class="category-list">
            <a href="@Url.Action("Index", "Home", new { categoryId = 0 })" 
               class="category-chip @(ViewBag.SelectedCategory == null || ViewBag.SelectedCategory == 0 ? "active" : "")">
               ทั้งหมด
            </a>
            @foreach (var cat in categoryNames)
            {
                <a href="@Url.Action("Index", "Home", new { categoryId = cat.Key })" 
                   class="category-chip @(ViewBag.SelectedCategory == cat.Key ? "active" : "")">
                   @cat.Value
                </a>
            }
        </div>
    </section>

    <!-- CTA Section -->
    @if (Context.Session.GetString("UserId") == null)
    {
        <section class="cta-section">
            <h2>🚀 เริ่มต้นอ่านวันนี้</h2>
            <p>เข้าร่วมชุมชนนักอ่านและสร้างคลังหนังสือดิจิทัลของคุณ</p>
            <a class="btn-cta" asp-controller="Account" asp-action="Login">
                <i class="bi bi-person-plus-fill me-2"></i>สมัครสมาชิกฟรี
            </a>
        </section>
    }

</main>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Inter:wght@400;600;700&display=swap');

    .ebook-home {
        font-family: 'Sarabun', 'Inter', sans-serif;
        padding: 0 0 60px 0;
    }

    /* ── Hero ── */
    .hero-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        padding: 60px 32px 60px;
        background: linear-gradient(135deg, #29579D 0%, #1a3a6e 60%, #0d1f40 100%);
        border-radius: 0 0 32px 32px;
        color: #fff;
        margin-bottom: 56px;
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at top right, rgba(255,255,255,0.07) 0%, transparent 60%);
        pointer-events: none;
    }

    .hero-content { max-width: 560px; z-index: 1; }

    .hero-welcome {
        font-size: 1rem;
        opacity: 0.8;
        margin-bottom: 12px;
    }

    .hero-title {
        font-size: 2.6rem;
        font-weight: 700;
        line-height: 1.25;
        margin-bottom: 14px;
    }

    .hero-sub {
        font-size: 1.05rem;
        opacity: 0.75;
        margin-bottom: 28px;
    }

    .btn-hero {
        display: inline-flex;
        align-items: center;
        padding: 12px 28px;
        background: #fff;
        color: #29579D;
        font-weight: 700;
        border-radius: 50px;
        text-decoration: none;
        font-size: 0.97rem;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    }

    .btn-hero:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        color: #1a3a6e;
    }

    /* Hero Illustration */
    .hero-illustration {
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }

    .hero-book-stack {
        display: flex;
        align-items: flex-end;
        gap: -8px;
        position: relative;
    }

    .hero-book {
        font-size: 5rem;
        filter: drop-shadow(0 8px 16px rgba(0,0,0,0.3));
        animation: float 3s ease-in-out infinite;
    }

    .hero-book.b1 { --rot: -10deg; animation-delay: 0s; transform: rotate(var(--rot)); }
    .hero-book.b2 { --rot: 0deg; animation-delay: 0.4s; font-size: 6rem; display: flex; align-items: center; justify-content: center; z-index: 2; transform: rotate(var(--rot)); }
    .hero-book.b3 { --rot: 10deg; animation-delay: 0.8s; transform: rotate(var(--rot)); }

    .hero-img { 
        width: auto;
        height: auto;
        max-width: 150px; 
        max-height: 210px; 
        object-fit: contain; 
        @* border-radius: 4px; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.1); *@
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
        50% { transform: translateY(-12px) rotate(var(--rot, 0deg)); }
    }

    /* ── Section Common ── */
    .featured-section,
    .categories-section {
        padding: 0 32px;
        margin-bottom: 48px;
    }

    .section-header { margin-bottom: 28px; }

    .section-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 4px;
    }

    .section-sub { color: #6b7280; font-size: 0.95rem; }

    /* ── Book Grid ── */
    .book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 24px;
    }

    .book-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .book-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        transition: transform 0.22s, box-shadow 0.22s;
        border: 1px solid rgba(0,0,0,0.06);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .book-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(41,87,157,0.18);
    }

    .book-cover {
        width: 100%;
        height: 200px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
    }

    .book-cover-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .book-no-cover {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e8f0fe, #c7d7f8);
    }

    .no-cover-icon { font-size: 2.8rem; }

    .no-cover-text {
        font-size: 0.8rem;
        color: #29579D;
        font-weight: 600;
        text-align: center;
        padding: 0 8px;
    }

    .book-info {
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .book-category {
        font-size: 0.72rem;
        font-weight: 600;
        color: #29579D;
        background: #eef3fc;
        display: inline-block;
        padding: 3px 10px;
        border-radius: 50px;
        margin-bottom: 8px;
    }

    .book-title {
        font-size: 0.97rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 6px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .book-desc {
        font-size: 0.8rem;
        color: #6b7280;
        flex: 1;
        margin-bottom: 12px;
        line-height: 1.5;
    }

    .book-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #f1f5f9;
        padding-top: 10px;
    }

    .book-price {
        font-size: 1.05rem;
        font-weight: 700;
        color: #16a34a;
    }

    .btn-view-detail {
        font-size: 0.8rem;
        font-weight: 600;
        color: #29579D;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    /* ── Empty State ── */
    .empty-state {
        text-align: center;
        padding: 64px 20px;
        background: #f8faff;
        border-radius: 16px;
        border: 2px dashed #c0ccdf;
    }

    .empty-icon { font-size: 4rem; margin-bottom: 16px; }

    /* ── Categories ── */
    .category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .category-chip {
        background: #fff;
        border: 1px solid #e2e8f0;
        padding: 10px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        color: #374151;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        text-decoration: none;
        display: inline-block;
    }
    
    .category-chip.active {
        background: #29579D;
        color: #fff;
        border-color: #29579D;
        box-shadow: 0 4px 14px rgba(41,87,157,0.25);
    }

    .category-chip:hover {
        background: #29579D;
        color: #fff;
        border-color: #29579D;
        transform: translateY(-2px);
        box-shadow: 0 4px 14px rgba(41,87,157,0.25);
    }

    /* ── CTA ── */
    .cta-section {
        margin: 0 32px;
        text-align: center;
        background: linear-gradient(135deg, #29579D, #1a3a6e);
        padding: 52px 40px;
        border-radius: 24px;
        color: #fff;
        box-shadow: 0 8px 32px rgba(41,87,157,0.28);
    }

    .cta-section h2 {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .cta-section p {
        opacity: 0.8;
        margin-bottom: 28px;
        font-size: 1rem;
    }

    .btn-cta {
        display: inline-flex;
        align-items: center;
        padding: 13px 32px;
        background: #fff;
        color: #29579D;
        font-weight: 700;
        border-radius: 50px;
        text-decoration: none;
        font-size: 1rem;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 18px rgba(0,0,0,0.18);
    }

    .btn-cta:hover {
        transform: translateY(-2px) scale(1.03);
        color: #1a3a6e;
        box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    }

    @@media (max-width: 768px) {
        .hero-section { flex-direction: column; padding: 40px 20px; text-align: center; }
        .hero-title { font-size: 1.9rem; }
        .hero-illustration { display: none; }
        .featured-section, .categories-section, .cta-section { padding: 0 16px; margin: 0 0 36px 0; }
        .cta-section { margin: 0; }
        .book-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; }
    }
</style>
